---
import { getDictionary, langPath } from '@i18n/config';
import type { Lang } from '@i18n/config';

const { lang } = Astro.props;
const dict = getDictionary(lang);
---

<header class="sidebar-header">
  <h1 class="site-title">
    <a href={langPath(lang, '/')}>{dict.siteName}</a>
  </h1>
  <p class="site-description">{dict.siteDescription}</p>
</header>

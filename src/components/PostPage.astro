---
import { getDictionary, langPath } from '@i18n/config';
import type { Lang } from '@i18n/config';
import { formatDate, readMinutes, getPrevNext, postLang, sortPosts, filterByLang } from '@utils/posts';
import type { Post } from '@utils/posts';
import { getCollection, render } from 'astro:content';

interface Props {
  post: Post;
  lang: Lang;
  slug: string;
}

const { post, lang, slug } = Astro.props;
const dict = getDictionary(lang);

const allPosts = await getCollection('blog');
const langPosts = filterByLang(allPosts, lang);
const sortedPosts = sortPosts(langPosts);
const { prev, next } = getPrevNext(sortedPosts, post);

const { Content } = await render(post);
const pubDate = post.data.pubDate;
const minutes = readMinutes(post.body);
const formattedDate = formatDate(pubDate, lang);
const siteUrl = Astro.site!.toString();
const canonical = new URL(langPath(lang, `/posts/${slug}`), Astro.site!);
const ogImage = post.data.cover ? new URL(post.data.cover, Astro.site!).toString() : `${siteUrl}/og-default.png`;

// Breadcrumb JSON-LD
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": dict.nav.home, "item": `${siteUrl}${langPath(lang, '/')}` },
    { "@type": "ListItem", "position": 2, "name": dict.sections.thoughts, "item": `${siteUrl}${langPath(lang, '/thoughts')}` },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": canonical.toString() }
  ]
};

// BlogPosting JSON-LD
const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": ogImage,
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "author": { "@type": "Person", "name": post.data.author || "TRIP" },
  "publisher": { "@type": "Organization", "name": "Nerf's World" },
  "inLanguage": lang,
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical.toString() }
};

function getPostSlug(p: Post, l: Lang): string {
  return p.id.startsWith(`${l}/`) ? p.id.slice(l.length + 1) : p.id;
}
---

<article class="post-page">
  <p class="section-label">{dict.sections.post}</p>
  <h1>{post.data.title}</h1>
  <p class="lede">{post.data.description}</p>
  <div class="post-meta">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    <span>·</span>
    <span>{dict.metaMinRead(minutes)}</span>
    {post.data.tags.length > 0 && (
      <>
        <span>·</span>
        <span>{post.data.tags.map(t => `#${t}`).join(', ')}</span>
      </>
    )}
  </div>
  <div class="post-tags">
    {post.data.tags.map((tag) => (
      <a class="tag" href={langPath(lang, `/tags/${tag}`)}>{tag}</a>
    ))}
  </div>
  <div class="post-content">
    <Content />
  </div>
  {prev || next ? (
    <nav class="pager" aria-label="Navigation">
      {prev ? (
        <a class="prev" href={langPath(lang, `/posts/${getPostSlug(prev, lang)}`)}>
          <span class="pager-label">{dict.prev}</span>
          <span class="pager-title">{prev.data.title}</span>
        </a>
      ) : (
        <div class="prev empty-slot"><span class="pager-label">{dict.prev}</span></div>
      )}
      {next ? (
        <a class="next" href={langPath(lang, `/posts/${getPostSlug(next, lang)}`)}>
          <span class="pager-label">{dict.next}</span>
          <span class="pager-title">{next.data.title}</span>
        </a>
      ) : (
        <div class="next empty-slot"><span class="pager-label">{dict.next}</span></div>
      )}
    </nav>
  ) : null}
</article>
---
import type { Lang } from '@i18n/config';
import { site } from '@config/site';
import { langPath } from '@i18n/config';

const { lang } = Astro.props;
const rssHref = lang === 'es' ? '/feed.xml' : '/en/feed.xml';
const currentPath = Astro.url.pathname;

function getAlternatePath(currentLang: Lang, path: string): string {
  const otherLang = currentLang === 'es' ? 'en' : 'es';
  
  if (path === '/') return langPath(otherLang, '/');
  if (path.startsWith('/en/')) return path.replace('/en/', otherLang === 'es' ? '/' : '/en/');
  if (path.startsWith('/posts/')) return langPath(otherLang, path);
  if (path.startsWith('/tags/')) return langPath(otherLang, path);
  if (path.startsWith('/thoughts')) return langPath(otherLang, '/thoughts');
  if (path.startsWith('/trips')) return langPath(otherLang, '/trips');
  if (path.startsWith('/about')) return langPath(otherLang, '/about');
  if (path.startsWith('/tags')) return langPath(otherLang, '/tags');
  return langPath(otherLang, '/');
}

const alternateHref = getAlternatePath(lang, currentPath);
const alternateLabel = lang === 'es' ? 'English' : 'Español';
---

<div class="sideBarActions">
  <a href={rssHref} aria-label="RSS feed" title="RSS">
    <img src="/icons/rss.svg" alt="RSS" />
  </a>

  <a
    href={site.github}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub"
    title="GitHub"
  >
    <img src="/icons/github.svg" alt="GitHub" />
  </a>

  <a
    href={alternateHref}
    aria-label={alternateLabel}
    title={alternateLabel}
    class="lang-toggle"
  >
    <img src="/icons/lang.svg" alt={alternateLabel} />
  </a>

  <button
    aria-label="Toggle theme"
    title="Toggle theme"
    id="toggleBtn"
  >
    <img src="/icons/theme.svg" alt="Theme" />
  </button>
</div>

<script is:inline>
  const theme = (() => {
    const stored = localStorage.getItem('theme') ?? '';
    if (['dark', 'light'].includes(stored)) {
      return stored;
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
    return 'light';
  })();

  if (theme === 'light') {
    document.documentElement.classList.remove('dark');
  } else {
    document.documentElement.classList.add('dark');
  }

  window.localStorage.setItem('theme', theme);

  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle('dark');
    const isDark = element.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  document
    .getElementById('toggleBtn')
    ?.addEventListener('click', handleToggleClick);
</script>
---
import Layout from '@layouts/Layout.astro';
import { getDictionary } from '@i18n/config';

const dict = getDictionary('es');
---

<Layout lang="es" pageTitle={dict.aboutTitle} description={dict.aboutIntro}>
  <section class="about">
    <h2>{dict.aboutTitle}</h2>
    {dict.aboutBody.map((p) => (
      <p class="about-paragraph">{p}</p>
    ))}
  </section>
</Layout>
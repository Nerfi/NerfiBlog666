---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getDictionary, langPath, postLang } from '@i18n/config';
import type { Lang } from '@i18n/config';

const lang: Lang = 'en';
const dict = getDictionary(lang);

const allPosts = await getCollection('blog');
const langPosts = allPosts.filter((p) => postLang(p.id) === lang);

const tagCounts: Record<string, number> = {};
for (const post of langPosts) {
  for (const tag of post.data.tags) {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  }
}

const tags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));
---

<Layout lang={lang} pageTitle={dict.tagsTitle} description={dict.tagsIntro}>
  <section class="tags-index">
    <p class="section-label">{dict.sections.tags}</p>
    <h1>{dict.tagsTitle}</h1>
    <p class="tags-intro">{dict.tagsIntro}</p>
    {tags.length > 0 ? (
      <div class="tag-cloud">
        {tags.map((tag) => (
          <a class="tag" href={langPath(lang, `/tags/${tag.name}`)} key={tag.name}>
            #{tag.name}
            <span class="tag-count">{dict.tagCount(tag.count)}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">{dict.empty}</p>
    )}
  </section>
</Layout>
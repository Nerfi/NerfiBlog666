---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getDictionary, langPath } from '@i18n/config';
import { postLang, formatDate, sortPosts } from '@utils/posts';
import type { Lang } from '@i18n/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = new Set<string>();
  for (const post of posts) {
    if (postLang(post.id) === 'en') {
      for (const tag of post.data.tags) tags.add(tag);
    }
  }
  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag, lang: 'en' as Lang },
  }));
}

const { tag, lang } = Astro.props;
const dict = getDictionary(lang);

const allPosts = await getCollection('blog');
const tagged = sortPosts(
  allPosts.filter((p) => postLang(p.id) === lang && p.data.tags.includes(tag))
);

const canonical = new URL(langPath(lang, `/tags/${tag}`), Astro.site!);
---

<Layout lang={lang} pageTitle={`#${tag} · ${dict.siteName}`} description={`${dict.tagCount(tagged.length)} tagged with #${tag}`} altUrls={{ es: `/tags/${tag}`, en: `/en/tags/${tag}` }}>
  <section class="tag-page">
    <p class="section-label">{dict.sections.tags}</p>
    <h1>#{tag}</h1>
    <p class="tag-summary">{dict.tagCount(tagged.length)}</p>
    {tagged.length > 0 ? (
      <ul class="post-list">
        {tagged.map((post) => (
          <li class="post-list-item">
            <time class="post-date" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate, lang)}
            </time>
            <h3 class="post-title">
              <a href={langPath(lang, `/posts/${post.id}`)}>{post.data.title}</a>
            </h3>
            <p class="post-description">{post.data.description}</p>
            <div class="post-tags">
              {post.data.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">{dict.empty}</p>
    )}
  </section>
</Layout>
---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getDictionary, langPath } from '@i18n/config';
import { postLang, formatDate, sortPosts } from '@utils/posts';
import type { Lang } from '@i18n/config';

const lang: Lang = 'en';
const dict = getDictionary(lang);

const allPosts = await getCollection('blog');
const trips = sortPosts(
  allPosts.filter((p) => postLang(p.id) === lang && p.data.tags.includes('trips'))
);
---

<Layout lang={lang} pageTitle={dict.sections.trips} description={dict.aboutIntro}>
  <section class="trips">
    <p class="section-label">{dict.sections.trips}</p>
    <h1>{dict.sections.trips}</h1>
    {trips.length > 0 ? (
      <ul class="trip-list">
        {trips.map((post) => (
          <li class="trip-card">
            <a href={langPath(lang, `/posts/${post.id}`)}>
              {post.data.cover && (
                <img src={post.data.cover} alt={post.data.title} loading="lazy" />
              )}
              <div class="trip-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate, lang)}
                </time>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">{dict.empty}</p>
    )}
  </section>
</Layout>
---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getDictionary, langPath } from '@i18n/config';
import type { Lang } from '@i18n/config';

const lang: Lang = 'en';
const dict = getDictionary(lang);

const allPosts = await getCollection('blog');
const thoughts = allPosts
  .filter((p) => postLang(p.id) === lang && p.data.tags.includes('thoughts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function groupByYear(posts: typeof thoughts): Record<string, typeof posts> {
  const groups: Record<string, typeof posts> = {};
  for (const post of posts) {
    const year = post.data.pubDate.getFullYear().toString();
    (groups[year] ??= []).push(post);
  }
  return groups;
}

const byYear = groupByYear(thoughts);
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<Layout lang={lang} pageTitle={dict.sections.thoughts} description={dict.aboutIntro}>
  <section class="thoughts">
    <p class="section-label">{dict.sections.thoughts}</p>
    <h1>{dict.sections.thoughts}</h1>
    {years.length > 0 ? (
      years.map((year) => (
        <article class="year-group" key={year}>
          <h2 class="year-heading">{year}</h2>
          <ul class="post-list">
            {byYear[year].map((post) => (
              <li class="post-list-item" key={post.id}>
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate, lang)}
                </time>
                <h3 class="post-title">
                  <a href={langPath(lang, `/posts/${post.id}`)}>{post.data.title}</a>
                </h3>
                <p class="post-description">{post.data.description}</p>
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag" key={tag}>{tag}</span>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))
    ) : (
      <p class="empty">{dict.empty}</p>
    )}
  </section>
</Layout>

<script>
  function formatDate(date: Date, lang: 'es' | 'en'): string {
    const locale = lang === 'es' ? 'es-ES' : 'en-US';
    return new Intl.DateTimeFormat(locale, { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
  }
  function postLang(id: string): 'es' | 'en' {
    return id.startsWith('en/') ? 'en' : 'es';
  }
</script>
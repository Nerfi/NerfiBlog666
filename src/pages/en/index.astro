---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getDictionary } from '@i18n/config';
import { postLang, formatDate, sortPosts } from '@utils/posts';

const dict = getDictionary('en');

const allPosts = await getCollection('blog');
const latest = sortPosts(allPosts.filter((p) => postLang(p.id) === 'en')).slice(0, 3);
---

<Layout lang="en" pageTitle={dict.homeTitle} description={dict.homeIntro}>
  <section class="home">
    <h2 class="home-label">{dict.homeLabel}</h2>
    <p class="home-intro">{dict.homeIntro}</p>
    <div class="home-paths" aria-label="Paths">
      {dict.paths.map((p) => (
        <article class="home-path" aria-labelledby={p.title}>
          <h3 class="home-path-title"><a href={p.href}>{p.title}</a></h3>
          <p class="home-path-body">{p.body}</p>
        </article>
      ))}
    </div>
    {latest.length > 0 && (
      <article class="home-latest">
        <h3>{dict.latestTitle}</h3>
        <ul>
          {latest.map((post) => (
            <li>
              <a href={`/posts/${post.id}`} class="post-summary">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate, 'en')}
                </time>
                <span class="post-summary-meta">
                  {post.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </span>
                <span>{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    )}
  </section>
</Layout>
---
import Layout from '@layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { getDictionary } from '@i18n/config';

const entry = await getEntry('about', 'en');
if (!entry) throw new Error("Missing About content: src/about/en.md");
const { Content } = await render(entry);
---

<Layout lang="en" pageTitle={`${entry.data.title} · ${getDictionary('en').siteName}`} description={entry.data.description} altUrls={{ es: '/about/', en: '/en/about/' }}>
  <section class="about">
    <h1>{entry.data.title}</h1>
    <div class="post-content">
      <Content />
    </div>
  </section>
</Layout>

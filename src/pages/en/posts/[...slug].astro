---
import { getCollection } from 'astro:content';
import PostPage from '@components/PostPage.astro';
import { getDictionary, langPath, postLang } from '@i18n/config';
import type { Lang } from '@i18n/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => postLang(p.id) === 'en')
    .map((post) => ({
      params: { slug: post.id.slice(3) },
      props: { post, lang: 'en' as Lang },
    }));
}

const { post, lang } = Astro.props;
const dict = getDictionary(lang);
const canonical = new URL(langPath(lang, `/posts/${post.id.slice(3)}`), Astro.site!);
const ogImage = post.data.cover ? new URL(post.data.cover, Astro.site!).toString() : `${Astro.site!}/og-default.png`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": dict.nav.home, "item": `${Astro.site!}${langPath(lang, '/')}` },
      { "@type": "ListItem", "position": 2, "name": dict.sections.thoughts, "item": `${Astro.site!}${langPath(lang, '/thoughts')}` },
      { "@type": "ListItem", "position": 3, "name": post.data.title, "item": canonical.toString() }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "image": ogImage,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": post.data.pubDate.toISOString(),
    "author": { "@type": "Person", "name": post.data.author || "TRIP" },
    "publisher": { "@type": "Organization", "name": "Nerf's World" },
    "inLanguage": lang,
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonical.toString() }
  }
];

---

<PostPage post={post} lang={lang} />
---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
---

<Layout lang="es" pageTitle={frontmatter.title}>
  <article>
    <p class="section-label">Escrito</p>
    <h1>{frontmatter.title}</h1>
    <p class="lede">{frontmatter.description}</p>
    <slot />
  </article>
</Layout>
